# VelaTrace Environment Configuration (Example — Do not commit real secrets)

# PostgreSQL Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/velatrace
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/velatrace_test

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
DEMO_WORKSPACE_ID=ws_northbridge_demo
SECRET_KEY=replace-with-random-secret-key

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
